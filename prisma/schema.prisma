generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String             @id @default(cuid())
  username       String             @unique
  password       String
  role           Role               @default(ORANGTUA)
  name           String
  status         Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  guru           Guru?
  informasiList  InformasiSekolah[]
  orangTua       OrangTua?
  pengumumanPmbm PengumumanPmbm[]

  @@map("users")
}

model InformasiSekolah {
  idInfo        Int          @id @default(autoincrement())
  kategori      KategoriInfo
  judul         String       @db.VarChar(100)
  isi           String       @db.Text
  gambar        String?      @db.VarChar(255)
  tanggalUpdate DateTime     @default(now()) @updatedAt
  idUser        String
  admin         User         @relation(fields: [idUser], references: [id], onDelete: NoAction)

  @@index([idUser], map: "informasi_sekolah_idUser_fkey")
  @@map("informasi_sekolah")
}

model TahunAjaran {
  id        Int      @id @default(autoincrement())
  nama      String   @unique @db.VarChar(20)
  semester  Semester
  aktif     Boolean  @default(false)
  createdAt DateTime @default(now())
  jadwal    Jadwal[]
  kelas     Kelas[]

  @@map("tahun_ajaran")
}

model Kelas {
  id            Int         @id @default(autoincrement())
  nama          String      @db.VarChar(20)
  tingkat       Int
  tahunAjaranId Int
  waliKelasId   String?
  jadwal        Jadwal[]
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: NoAction)
  waliKelas     Guru?       @relation("WaliKelas", fields: [waliKelasId], references: [id])
  siswa         Siswa[]

  @@index([tahunAjaranId], map: "kelas_tahunAjaranId_fkey")
  @@index([waliKelasId], map: "kelas_waliKelasId_fkey")
  @@map("kelas")
}

model Guru {
  id                       String               @id
  nip                      String?              @unique @db.VarChar(20)
  mapel                    String               @db.VarChar(100)
  noHp                     String?              @db.VarChar(20)
  alamat                   String?              @db.Text
  pendidikan               String?              @db.VarChar(100)
  absensiDibuat            Absensi[]
  catatanUmumAbsensiDibuat AbsensiCatatanUmum[]
  user                     User                 @relation(fields: [id], references: [id], onDelete: NoAction)
  guruMapel                GuruMapel[]
  hafalanDibuat            Hafalan[]            @relation("GuruHafalan")
  jadwal                   Jadwal[]
  kelasWali                Kelas[]              @relation("WaliKelas")
  nilaiDibuat              Nilai[]
  sikapDibuat              Sikap[]              @relation("GuruSikap")
  tahsinDibuat             Tahsin[]             @relation("GuruTahsin")

  @@map("guru")
}

model OrangTua {
  id        String  @id
  noHp      String? @db.VarChar(20)
  alamat    String? @db.Text
  pekerjaan String? @db.VarChar(100)
  user      User    @relation(fields: [id], references: [id], onDelete: NoAction)
  anak      Siswa[]

  @@map("orang_tua")
}

model Siswa {
  id            Int          @id @default(autoincrement())
  nis           String       @unique @db.VarChar(20)
  nama          String       @db.VarChar(100)
  jenisKelamin  JenisKelamin
  tanggalLahir  DateTime     @db.Date
  kelasId       Int
  orangTuaId    String?
  status        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  alamat        String?      @db.Text
  namaAyah      String?      @db.VarChar(100)
  namaIbu       String?      @db.VarChar(100)
  statusTahfidz Boolean      @default(false)
  tempatLahir   String?      @db.VarChar(50)
  absensi       Absensi[]
  hafalan       Hafalan[]
  nilai         Nilai[]
  sikap         Sikap[]
  kelas         Kelas        @relation(fields: [kelasId], references: [id], onDelete: NoAction)
  orangTua      OrangTua?    @relation(fields: [orangTuaId], references: [id])
  tahsin        Tahsin[]

  @@index([kelasId], map: "siswa_kelasId_fkey")
  @@index([orangTuaId], map: "siswa_orangTuaId_fkey")
  @@map("siswa")
}

model Jadwal {
  id                 Int                  @id @default(autoincrement())
  kelasId            Int
  guruId             String
  hari               Hari
  jamMulai           String               @db.VarChar(5)
  jamSelesai         String               @db.VarChar(5)
  kodeMapel          String               @db.VarChar(5)
  tahunAjaranId      Int
  absensi            Absensi[]
  catatanUmumAbsensi AbsensiCatatanUmum[]
  guru               Guru                 @relation(fields: [guruId], references: [id], onDelete: NoAction)
  kelas              Kelas                @relation(fields: [kelasId], references: [id], onDelete: NoAction)
  mataPelajaran      MataPelajaran        @relation(fields: [kodeMapel], references: [kodeMapel], onDelete: NoAction)
  tahunAjaran        TahunAjaran          @relation(fields: [tahunAjaranId], references: [id], onDelete: NoAction)

  @@unique([kelasId, hari, jamMulai, tahunAjaranId])
  @@unique([guruId, hari, jamMulai, tahunAjaranId])
  @@index([kodeMapel], map: "jadwal_kodeMapel_fkey")
  @@index([tahunAjaranId], map: "jadwal_tahunAjaranId_fkey")
  @@map("jadwal")
}

model Absensi {
  id         Int           @id @default(autoincrement())
  siswaId    Int
  jadwalId   Int
  guruId     String
  tanggal    DateTime      @db.Date
  status     StatusAbsensi
  keterangan String?       @db.VarChar(255)
  createdAt  DateTime      @default(now())
  guru       Guru          @relation(fields: [guruId], references: [id], onDelete: NoAction)
  jadwal     Jadwal        @relation(fields: [jadwalId], references: [id], onDelete: NoAction)
  siswa      Siswa         @relation(fields: [siswaId], references: [id], onDelete: NoAction)

  @@unique([siswaId, jadwalId, tanggal])
  @@index([guruId], map: "absensi_guruId_fkey")
  @@index([jadwalId], map: "absensi_jadwalId_fkey")
  @@map("absensi")
}

model AbsensiCatatanUmum {
  id        Int      @id @default(autoincrement())
  jadwalId  Int
  tanggal   DateTime @db.Date
  catatan   String   @db.Text
  guruId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guru      Guru     @relation(fields: [guruId], references: [id], onDelete: NoAction)
  jadwal    Jadwal   @relation(fields: [jadwalId], references: [id], onDelete: NoAction)

  @@unique([jadwalId, tanggal])
  @@index([guruId], map: "absensi_catatan_umum_guruId_fkey")
  @@map("absensi_catatan_umum")
}

model Nilai {
  id          Int        @id @default(autoincrement())
  siswaId     Int
  guruId      String
  jenis       JenisNilai
  nilai       Decimal    @db.Decimal(5, 2)
  semester    Semester
  tahunAjar   String     @db.VarChar(20)
  keterangan  String?    @db.VarChar(255)
  tanggal     DateTime   @db.Date
  guruMapelId Int
  guru        Guru       @relation(fields: [guruId], references: [id], onDelete: NoAction)
  guruMapel   GuruMapel  @relation(fields: [guruMapelId], references: [idGuruMapel], onDelete: NoAction)
  siswa       Siswa      @relation(fields: [siswaId], references: [id], onDelete: NoAction)

  @@unique([siswaId, guruMapelId, jenis, semester, tahunAjar])
  @@index([guruId], map: "nilai_guruId_fkey")
  @@index([guruMapelId], map: "nilai_guruMapelId_fkey")
  @@map("nilai")
}

model Sikap {
  id         Int        @id @default(autoincrement())
  siswaId    Int
  semester   Semester
  tahunAjar  String     @db.VarChar(20)
  tanggal    DateTime   @db.Date
  guruId     String
  jenisSikap JenisSikap
  kategori   String     @db.VarChar(50)
  keterangan String     @db.Text
  createdAt  DateTime   @default(now())
  guru       Guru       @relation("GuruSikap", fields: [guruId], references: [id], onDelete: NoAction)
  siswa      Siswa      @relation(fields: [siswaId], references: [id], onDelete: NoAction)

  @@index([guruId], map: "sikap_guruId_fkey")
  @@index([siswaId], map: "sikap_siswaId_fkey")
  @@map("sikap")
}

model Hafalan {
  id         Int          @id @default(autoincrement())
  siswaId    Int
  juz        Int          @db.TinyInt
  nilai      NilaiHafalan
  tanggal    DateTime     @db.Date
  guruId     String
  hari       Hari
  surat      String       @db.VarChar(50)
  halaman    Int
  keterangan String?      @db.Text
  createdAt  DateTime     @default(now())
  guru       Guru         @relation("GuruHafalan", fields: [guruId], references: [id], onDelete: NoAction)
  siswa      Siswa        @relation(fields: [siswaId], references: [id], onDelete: NoAction)

  @@index([guruId], map: "hafalan_guruId_fkey")
  @@index([siswaId], map: "hafalan_siswaId_fkey")
  @@map("hafalan")
}

model Tahsin {
  id         Int          @id @default(autoincrement())
  siswaId    Int
  tanggal    DateTime     @db.Date
  guruId     String
  hari       Hari
  juz        Int          @db.TinyInt
  surat      String       @db.VarChar(50)
  halaman    Int
  tajwid     NilaiHafalan
  makhraj    NilaiHafalan
  sifatul    NilaiHafalan
  keterangan String?      @db.Text
  createdAt  DateTime     @default(now())
  guru       Guru         @relation("GuruTahsin", fields: [guruId], references: [id], onDelete: NoAction)
  siswa      Siswa        @relation(fields: [siswaId], references: [id], onDelete: NoAction)

  @@index([guruId], map: "tahsin_guruId_fkey")
  @@index([siswaId], map: "tahsin_siswaId_fkey")
  @@map("tahsin")
}

model MataPelajaran {
  kodeMapel String      @id @db.VarChar(5)
  namaMapel String      @db.VarChar(20)
  guruMapel GuruMapel[]
  jadwal    Jadwal[]

  @@map("mata_pelajaran")
}

model GuruMapel {
  idGuruMapel   Int           @id @default(autoincrement())
  idGuru        String        @db.VarChar(30)
  kodeMapel     String        @db.VarChar(5)
  guru          Guru          @relation(fields: [idGuru], references: [id], onDelete: NoAction)
  mataPelajaran MataPelajaran @relation(fields: [kodeMapel], references: [kodeMapel], onDelete: NoAction)
  nilai         Nilai[]

  @@unique([idGuru, kodeMapel])
  @@index([kodeMapel], map: "guru_mapel_kodeMapel_fkey")
  @@map("guru_mapel")
}

model PengumumanPmbm {
  id        Int      @id @default(autoincrement())
  judul     String   @db.VarChar(200)
  deskripsi String?  @db.Text
  filePath  String   @db.VarChar(255)
  fileName  String   @db.VarChar(255)
  tahun     String   @db.VarChar(20)
  idUser    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     User     @relation(fields: [idUser], references: [id], onDelete: NoAction)

  @@index([idUser], map: "pengumuman_pmbm_idUser_fkey")
  @@map("pengumuman_pmbm")
}

enum Role {
  ADMIN
  GURU
  ORANGTUA
}

enum KategoriInfo {
  sejarah
  visi
  misi
  tujuan
  fasilitas
  kurikulum
  prestasi
  berita
  ekstrakurikuler
  psb
  statistik
}

enum Semester {
  GANJIL
  GENAP
}

enum JenisKelamin {
  L
  P
}

enum Hari {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

enum StatusAbsensi {
  HADIR
  SAKIT
  IZIN
  ALPHA
}

enum JenisNilai {
  TUGAS
  HARIAN
  PR
  UTS
  UAS
  PRAKTIK
}

enum JenisSikap {
  POSITIF
  PELANGGARAN
}

enum NilaiHafalan {
  L
  L_MIN @map("L-")
}
